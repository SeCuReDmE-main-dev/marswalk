# Static is the default. No middleware process is required.
VITE_DATA_MODE=static
# Optional: remote static pack URL. Defaults to BASE_URL + data/jezero/v1.
# VITE_PACK_URL=https://example.com/public_packs/jezero/v1
# Live planning, assessment, cell lookup and cached cameras use this address
# in either data mode. Static mode connects only when requested.
VITE_API_BASE_URL=http://127.0.0.1:8000
# To load the base pack from the team's API too:
# VITE_DATA_MODE=api
VITE_SITE_ID=jezero
