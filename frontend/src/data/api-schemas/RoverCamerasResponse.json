        "sol": {
          "title": "Sol",
          "type": "integer"
        },
        "site": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Site"
        },
        "drive": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drive"
        },
        "instrument": {
          "title": "Instrument",
          "type": "string"
        },
        "image_url": {
          "title": "Image Url",
          "type": "string"
        },
        "mast_azimuth_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mast Azimuth Deg"
        },
        "mast_elevation_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mast Elevation Deg"
