    "total_matching": {
      "title": "Total Matching",
      "type": "integer"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "title": "Page Size",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/RoverCameraItem"
